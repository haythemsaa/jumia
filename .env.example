# Application
APP_NAME="ICHRI Tunisia"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ichri.tn

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ichri_tunisia
DB_USERNAME=ichri_user
DB_PASSWORD=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@ichri.tn
MAIL_FROM_NAME="${APP_NAME}"

# Queue
QUEUE_CONNECTION=redis

# Cache
CACHE_DRIVER=redis
SESSION_DRIVER=redis

# Frontend
FRONTEND_URL=https://ichri.tn

# API
API_URL=https://api.ichri.tn

# Mobile
MOBILE_API_URL=https://api.ichri.tn/api
